{
  "name": "vh3",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:demo": "npx tsx prisma/seed-demo.ts",
    "seed:yashvanth": "npx tsx prisma/seed-yashvanth.ts",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "migrate:convex": "prisma generate && tsx scripts/migrate-prisma-to-convex.ts",
    "test:convex": "tsx scripts/smoke-convex.ts",
    "mobile": "npm run start --workspace @superfinz/mobile",
    "mobile:android": "npm run android --workspace @superfinz/mobile",
    "mobile:ios": "npm run ios --workspace @superfinz/mobile",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @superfinz/shared && npm run typecheck --workspace @superfinz/mobile",
    "test": "tsx --test packages/shared/src/*.test.ts src/lib/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@superfinz/shared": "file:packages/shared",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "date-fns": "^4.1.0",
    "google-auth-library": "^10.3.0",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "expo-router": "~57.0.18",
    "prisma": "^7.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
